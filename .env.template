# .env  ──────────────────────────────────────────────────────────────────────
# Copy this file, rename to .env, and fill in your real keys.
# NEVER commit .env to GitHub — add it to .gitignore

SECRET_KEY=your-flask-secret-key-here

# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Get key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# Get key at: https://console.cloud.google.com (for Maps embed)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# MongoDB Atlas connection string (optional)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/travel_planner

FLASK_DEBUG=true
